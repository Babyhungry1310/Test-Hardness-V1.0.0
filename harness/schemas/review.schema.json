{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "cycle", "date", "reviewer_model", "worker_models", "verdict", "items", "findings"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^RVW-CYC-\\d{2}$"},
    "cycle": {"type": "string", "pattern": "^CYC-\\d{2}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "reviewer_model": {"type": "string", "minLength": 1},
    "worker_models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "items": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TK-\\d{4} \\| done \\d+/\\d+ \\| (?:PASS|FAIL)$"}},
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "PASS"}}, "required": ["verdict"]},
      "then": {"properties": {"items": {"items": {"pattern": "\\| PASS$"}}}}
    }
  ]
}
