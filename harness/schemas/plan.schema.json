{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "date", "based_on"],
  "properties": {
    "schema": {"const": 1},
    "id": {"const": "PLAN"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "based_on": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^DEC-\\d{4}$"}}
  }
}
