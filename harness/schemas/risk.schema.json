{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "opened", "title", "related", "keywords"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^RSK-\\d{4}$"},
    "opened": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "title": {"type": "string", "minLength": 1},
    "related": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/pointer"}},
    "keywords": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
  },
  "$defs": {
    "pointer": {"type": "string", "pattern": "^(?:(?:(?:TK|DEC|RSK|REQ|SRC)-\\d{4}|CYC-\\d{2}|RVW-CYC-\\d{2}|DSC-\\d{8}-[a-z0-9]{4})(?:#[A-Z][A-Z0-9_]*)?|[A-Za-z0-9_][A-Za-z0-9_./-]*#[A-Z][A-Z0-9_]*|TK-\\d{4}\\.L\\d{2}(?:\\.S\\d{2})?)$"}
  }
}
