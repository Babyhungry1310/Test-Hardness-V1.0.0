{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "cycle", "origin", "assignee", "goal", "write_scope", "constraints", "inputs", "read_also", "line_budget", "verify", "done_when", "size", "depends_on", "fixes"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^TK-\\d{4}$"},
    "cycle": {"type": "string", "pattern": "^CYC-\\d{2}$"},
    "origin": {"type": "string", "pattern": "^(?:DEC-\\d{4}|01_plan/PLAN\\.md#CYC_\\d{2})$"},
    "assignee": {"type": "string", "pattern": "^W[1-9]\\d*$"},
    "goal": {"type": "string", "minLength": 1},
    "write_scope": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "read_also": {"type": "array", "items": {"$ref": "#/$defs/pointer_or_path"}},
    "line_budget": {"type": "integer", "minimum": 1},
    "verify": {"type": "string", "minLength": 1},
    "done_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "size": {"type": "string", "minLength": 1},
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TK-\\d{4}$"}},
    "fixes": {"type": "string", "pattern": "^(?:TK-\\d{4})?$"},
    "log_level": {"enum": ["LOOP", "SPAN"]},
    "max_loops": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"},
    "pointer": {"type": "string", "pattern": "^(?:(?:(?:TK|DEC|RSK|REQ|SRC)-\\d{4}|CYC-\\d{2}|RVW-CYC-\\d{2}|DSC-\\d{8}-[a-z0-9]{4})(?:#[A-Z][A-Z0-9_]*)?|[A-Za-z0-9_][A-Za-z0-9_./-]*#[A-Z][A-Z0-9_]*|TK-\\d{4}\\.L\\d{2}(?:\\.S\\d{2})?)$"},
    "pointer_or_path": {"anyOf": [{"$ref": "#/$defs/pointer"}, {"$ref": "#/$defs/path"}]}
  }
}
